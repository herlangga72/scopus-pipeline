# Scopus session
SCOPUS_CDP_PORT=9222
# CHROME_BIN=/usr/bin/brave
# CHROME_USER_DATA_DIR=/home/user/.config/BraveSoftware/Brave-Browser
CHROME_PROFILE_DIRECTORY=Scopus

# Throughput
SCOPUS_PROFILE_BATCH_SIZE=25
SCOPUS_REQUEST_DELAY_MS=400
SCOPUS_JOURNAL_DELAY_MS=300
SCOPUS_DOCUMENT_WAIT_MS=120000

# Data
DATA_DIR=data
SEED_AUTHOR_IDS=seed/example.csv
LOG_LEVEL=info

# Report matching. Set this to your own institution, for example:
# HOME_INSTITUTION_PATTERN=example university
HOME_INSTITUTION_PATTERN=$^
